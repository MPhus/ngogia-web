# Firebase Console -> Project settings -> Your apps -> Web app (project: ngogia-api)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=ngogia-api.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ngogia-api
VITE_FIREBASE_STORAGE_BUCKET=ngogia-api.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# EmailJS (https://dashboard.emailjs.com). Template: To={{to_email}}, Subject={{subject}}, Body={{{html_content}}}
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
# Shop mailbox receiving new-order notifications (was EMAIL_SELL on the API)
VITE_EMAIL_SELL=

# Cloudinary unsigned upload preset (Settings -> Upload -> Upload presets -> Signing mode: Unsigned)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
